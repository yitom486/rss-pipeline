# 复制为 .env 并填入真实值（.env 不会提交到 git）

# Telegram 审核机器人
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 模型后端默认 codex，通过 Codex 自己的登录状态认证
NEWS_PROVIDER=codex
CODEX_BIN=codex
# 留空使用 Codex 默认模型；也可通过 Telegram /models 选择
CODEX_MODEL=

# RSSHub 本地直连地址（可选，默认 http://127.0.0.1:1200）
RSSHUB_BASE=http://127.0.0.1:1200

# 开发/测试时可显式使用隔离配置与数据库
# RSS_ENV_PATH=/absolute/path/to/.env
# RSS_DB_PATH=/absolute/path/to/rss.db
